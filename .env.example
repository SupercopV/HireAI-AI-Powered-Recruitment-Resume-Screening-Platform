# ==============================================
# HireAI Configuration - Environment Variables
# ==============================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Security & Authentication
# Generate a secure secret using: openssl rand -hex 32
SECRET_KEY=change_this_to_a_super_secure_random_key_in_production_32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
# Local instance default: postgresql://postgres@localhost:5433/hireai
# Render/Cloud default: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres@localhost:5433/hireai

# Groq AI API Configuration
# Currently supported models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=4096

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=25
MAX_CV_BATCH_SIZE=500
UPLOAD_DIR=./uploads

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Environment Variables (Vite)
# VITE_API_BASE_URL=http://localhost:8000/api

